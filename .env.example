# Local runtime. Never use a VITE_ prefix for credentials.
PORT=8791
TRUSTED_ORIGIN=http://127.0.0.1:5173
# DATA_DIR=./data

# Official KICK developer app (optional; demo works without any values).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://127.0.0.1:8791/api/kick/callback
KICK_BROADCASTER_ID=
# Tokens are alternative server-only provisioning. OAuth tokens remain in memory.
KICK_ACCESS_TOKEN=
KICK_REFRESH_TOKEN=
KICK_ENABLE_OUTBOUND=false

# Optional OpenAI-compatible text provider. Default is local rules, $0 API cost.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Conservative reservation per request; configure from your provider's current prices.
AI_MAX_REQUEST_USD=

# Optional OpenAI-compatible speech endpoint. Browser speech is the default.
# Only the active, moderated character subtitle is sent; never arbitrary chat.
TTS_ENABLED=false
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# Reserve a conservative upper bound per line against the shared AI/TTS budget.
TTS_MAX_REQUEST_USD=

# Existing scientific screen's optional official status endpoint.
# VITE_KICK_STATUS_URL=/api/kick-status
